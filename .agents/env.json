{
  "version": "1.0.0",
  "activeEnvironment": "cachyos-linx",
  "defaultShell": "/bin/fish",
  "variables": {
    "MINDSCAPE_REPO": "/home/onecode/Mindscape",
    "MINDSCAPE_HARNESS": "/home/onecode/Mindscape/.agents",
    "MINDSCAPE_SKILLS": "/home/onecode/Mindscape/.agents/skills",
    "MINDSCAPE_DEFAULT_BASE_REF": "origin/dev",
    "MINDSCAPE_DEFAULT_BASE_BRANCH": "dev",
    "MINDSCAPE_PR_DESCRIPTION_OUTPUT": ".local/pr-description.md",
    "MINDSCAPE_GITHUB_HOST": "github.com",
    "MINDSCAPE_CURRICULUM": "/home/onecode/Documents/curriculum/",
    "MINDSCAPE_CURRENT_CV": "/home/onecode/Documents/curriculum/cv-2/"
  },
  "paths": {
    "repository": "/home/onecode/Mindscape",
    "harness": "/home/onecode/Mindscape/.agents",
    "agents": "/home/onecode/Mindscape/.agents/agents",
    "architecture": "/home/onecode/Mindscape/.agents/architecture",
    "skills": "/home/onecode/Mindscape/.agents/skills",
    "projectSkills": "/home/onecode/Mindscape/.agents/skills/project",
    "techSkills": "/home/onecode/Mindscape/.agents/skills/tech",
    "tasks": "/home/onecode/Mindscape/.agents/tasks",
    "workflows": "/home/onecode/Mindscape/.agents/workflows",
    "curriculumRoot": "/home/onecode/Documents/curriculum/",
    "currentCv": "/home/onecode/Documents/curriculum/cv-2/"
  },
  "gitHub": {
    "cli": "gh",
    "remote": "origin",
    "defaultHost": "github.com",
    "mutationPolicy": "explicit-human-approval"
  },
  "sourcePolicy": {
    "curriculumAccess": "read-only and task-relevant",
    "currentCv": "cv-2 is current reference",
    "copyExternalPersonalData": false,
    "writeExternalPersonalData": false,
    "secretsInConfig": false
  }
}
