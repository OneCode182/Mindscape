{
	"name": "canvas-template",
	"author": "HugoRCD",
	"private": true,
	"license": "Apache-2.0",
	"scripts": {
		"automd": "automd",
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"format": "pnpm exec biome format --write .",
		"format:check": "pnpm exec biome format .",
		"type-check": "pnpm exec tsc --noEmit",
		"typecheck": "pnpm run type-check",
		"lint:biome": "pnpm exec biome check .",
		"lint:biome:fix": "pnpm exec biome check --write .",
		"lint:eslint": "pnpm exec eslint .",
		"lint": "pnpm run type-check && pnpm run lint:biome",
		"lint:all": "pnpm run type-check && pnpm run lint:biome && pnpm run lint:eslint",
		"start": "node .output/server/index.mjs",
		"lint:fix": "pnpm run lint:biome:fix",
		"lint:fix:eslint": "pnpm exec eslint . --fix",
		"check": "pnpm run lint"
	},
	"packageManager": "pnpm@11.20.0",
	"dependencies": {
		"@nuxt/content": "^3.15.2",
		"@nuxt/devtools": "3.4.1",
		"@nuxt/image": "2.1.0",
		"@nuxt/scripts": "^0.13.4",
		"@nuxt/ui": "^4.10.0",
		"@nuxtjs/i18n": "^10.6.0",
		"@nuxtjs/seo": "^3.4.0",
		"@vueuse/core": "14.4.0",
		"@vueuse/nuxt": "14.4.0",
		"better-sqlite3": "^12.11.1",
		"nuxt": "4.5.1",
		"nuxt-studio": "1.7.0",
		"resend": "6.18.1",
		"sitemap": "9.0.1",
		"ufo": "^1.6.4",
		"vue-sonner": "2.0.9"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@iconify-json/heroicons": "^1.2.3",
		"@nuxt/eslint-config": "1.16.0",
		"automd": "0.4.3",
		"eslint": "9.39.5",
		"typescript": "^7.0.2"
	}
}
